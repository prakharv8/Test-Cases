rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Simple, trust-based rules matching the original app's model: anyone
    // who can open the site can read AND write the shared collections
    // (branches / claims / entries). There is no real per-person login on
    // a standalone site, so "admin" is enforced only in the page's own
    // JavaScript (the shared password gate) -- these rules can't see that
    // gate, so technically anyone who finds your site URL could write
    // directly to the database via the browser console, bypassing the
    // password. For an internal team tool shared only with people you
    // trust, this is usually an acceptable tradeoff. If you want this
    // locked down properly later, add Firebase Authentication and swap
    // this file for rules that check request.auth.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
